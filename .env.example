# ─── ClearClause Environment Configuration ───────────────────────────────────
# Copy this file to .env and fill in your values

# Get your FREE Groq API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use (llama3-8b-8192 is fast and free)
GROQ_MODEL=llama3-8b-8192

# Set to "true" to enable the heavy CUAD DeBERTa model (downloads ~500MB on first run)
# Leave as "false" for fast keyword-based extraction (recommended for demo)
USE_CUAD_MODEL=false
